# Database
DATABASE_URL="mysql://user:password@localhost:3306/bima_unggul"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Admin pertama hanya untuk bootstrap database produksi yang belum punya admin.
# Isi di backend/.env pada server (jangan commit nilai aslinya), lalu hapus
# keempat variabel ini setelah akun awal berhasil dibuat.
INITIAL_ADMIN_NIP=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
